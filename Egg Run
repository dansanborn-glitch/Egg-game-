    if(Math.hypot(vx,vy)<30) break;
  }
  ctx.globalAlpha=1;
  ctx.fillStyle='rgba(0,0,0,0.45)'; ctx.fillRect(wx-4, wy+18, 8, 34);
  ctx.fillStyle=G.aim.power>0.75?'#e8c23a':'#7ad06a';
