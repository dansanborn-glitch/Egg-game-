  ctx.translate(W/2, y+ph/2); ctx.rotate(0.16);
  ctx.fillStyle='#d8d8de';
  roundRect(-11,-18,22,36,4); ctx.fill();
  ctx.fillStyle='#8fa0b0'; ctx.fillRect(-8,-10,16,9);
  ctx.restore();
  for(let i=0;i<7;i++){
    const sx=rnd(L+6,L+CW-6), sy=rnd(y+6,y+ph-6), sr=rnd(2,6);
    ctx.fillStyle='rgba(245,240,220,0.9)';
    ctx.beginPath(); ctx.ellipse(sx,sy,sr,sr*0.72,rnd(0,3),0,6.29); ctx.fill();
  }
  ctx.save();
  ctx.translate(W/2,y+ph/2); ctx.rotate(-0.14);
  ctx.strokeStyle='#b3261e'; ctx.lineWidth=2;
  ctx.strokeRect(-62,-12,124,24);
  ctx.fillStyle='#b3261e';
  ctx.font='bold 16px Courier New'; ctx.textAlign='center'; ctx.textBaseline='middle';
  const grade = G.hits>=11?'LEGENDARY':G.hits>=8?'CLEAN GETAWAY':G.hits>=5?'DECENT ARM':'WEAK WRIST';
  ctx.fillText(grade,0,1);
  ctx.restore();
  ctx.textBaseline='alphabetic';
  y+=ph+12;
  ctx.textAlign='left';
  ctx.font='10px Courier New';
  ctx.fillStyle='#5a5a5a';
  ctx.fillText('THE CAR, LAST SEEN HEADING SOUTH. NO PLATES.', L, y);
  y+=10;

  ctx.fillStyle='#1b1b1b'; ctx.fillRect(L,y,W-2*L,1);
  y+=14;

  ctx.font='bold 12px Courier New';
  ctx.fillStyle='#1b1b1b';
  ctx.fillText('WHAT THEY SAID', L, y);
  y+=7;

  ctx.font='13px Courier New';
  const ql=wrapLines('“'+G.quote+'”',CW-16).slice(0,2);
  const qh=ql.length*15+20;
  ctx.strokeStyle='#1b1b1b'; ctx.lineWidth=1;
  ctx.strokeRect(L+.5,y+.5,CW-1,qh-1);
  ctx.fillStyle='#1b1b1b';
  let qy=y+16;
  for(const l of ql){ ctx.fillText(l,L+8,qy); qy+=15; }
  ctx.font='bold 12px Courier New';
  ctx.fillStyle='#5a5a5a';
  ctx.fillText('— '+G.quoteBy, L+8, y+qh-7);
  y+=qh+9;

  ctx.fillStyle='#1b1b1b'; ctx.fillRect(L,y,W-2*L,2);
  y+=13;

  ctx.font='bold 13px Courier New';
  ctx.fillStyle='#1b1b1b';
  ctx.fillText('THE TOLL', L, y);
  y+=4;

  const rows=[
    ['PEDESTRIANS SOAKED', G.cas.ped],
    ['CYCLISTS DOWN', G.cas.bike],
    ['MOTORISTS CAUGHT', G.cas.car],
    ['EGGS LANDED', G.hits+'/12'],
    ['BEST STREAK', G.bestStreak]
  ];
  y+=13;
  ctx.font='13px Courier New';
  for(const r of rows){
    ctx.fillStyle='#2a2a2a';
    ctx.fillText(r[0], L, y);
    ctx.textAlign='right';
    ctx.fillStyle='#141414';
    ctx.fillText(String(r[1]), R, y);
    ctx.textAlign='left';
    y+=13;
  }
  ctx.fillStyle='#1b1b1b'; ctx.fillRect(L,y-8,W-2*L,1);
  y+=4;
  ctx.font='bold 16px Courier New';
  ctx.fillStyle='#141414';
  ctx.fillText('TOTAL CASUALTIES', L, y);
  ctx.textAlign='right';
  ctx.fillStyle='#b3261e';
  ctx.fillText(String(G.cas.ped+G.cas.bike+G.cas.car), R, y);
  ctx.textAlign='left';
  y+=21;

  ctx.textAlign='center';
  ctx.font='bold 18px Courier New';
  const ready=G.overT>=OVER_GATE;
  ctx.fillStyle=ready?(Math.sin(performance.now()/260)>0?'#141414':'#8a8a8a'):'#b9b2a0';
  ctx.fillText(ready?'TAP TO RUN IT AGAIN':'reading the paper...', W/2, y);
  ctx.font='10px Courier New';
  ctx.fillStyle='#6a6a6a';
  ctx.fillText('the sidewalk will never be clean', W/2, y+17);
  ctx.restore();
}

function render(){
  ctx.save();
  const sx=(Math.random()-0.5)*G.shake, sy=(Math.random()-0.5)*G.shake;
  ctx.translate(sx,sy);
  if(Math.abs(G.zoom-1)>0.002){
    ctx.translate(G.zoomX,G.zoomY); ctx.scale(G.zoom,G.zoom); ctx.translate(-G.zoomX,-G.zoomY);
  }

  drawRoad();
  for(const l of G.boostLines){
    ctx.strokeStyle='rgba(210,235,255,'+clamp(l.life*1.6,0,0.5)+')';
    ctx.lineWidth=1.4;
    ctx.beginPath(); ctx.moveTo(l.x,l.y); ctx.lineTo(l.x,l.y+l.len); ctx.stroke();
  }
  drawBooths();
  drawBunting();
  for(const t of G.targets) if(t.type==='car') drawParkedCar(t);
  for(const t of G.targets) if(t.type!=='car'){ t.type==='bike'?drawBike(t):drawPed(t); }
  for(const s of G.splats) drawSplat(s);
  for(const e of G.flying) drawEgg(e);
  drawPlayerCar();
  drawAim();

  for(const f of G.fx){
    const a=clamp(f.life/f.max,0,1);
    ctx.globalAlpha=a;
    if(f.type==='text'){
      ctx.font='bold '+f.size+'px Courier New'; ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillStyle='rgba(0,0,0,0.6)'; ctx.fillText(f.text,f.x+1,f.y+1);
      ctx.fillStyle=f.color; ctx.fillText(f.text,f.x,f.y);
    } else if(f.type==='ring'){
      ctx.strokeStyle='#ffd24a'; ctx.lineWidth=3;
      ctx.beginPath(); ctx.arc(f.x,f.y,f.r,0,6.29); ctx.stroke();
    } else if(f.type==='smoke'){
      ctx.fillStyle='rgba(228,228,232,'+(a*0.42)+')';
      ctx.beginPath(); ctx.arc(f.x,f.y,f.r,0,6.29); ctx.fill();
    } else {
      ctx.fillStyle=f.col||'#fdf8e6';
      ctx.beginPath(); ctx.arc(f.x,f.y,f.r,0,6.29); ctx.fill();
    }
  }
  ctx.globalAlpha=1;

  drawBubbles();

  if(G.haze>0.01){
    ctx.fillStyle='rgba(14,14,19,'+(G.haze*0.94)+')';
    ctx.fillRect(-800,-800,1900,2100);
  }
  if(G.slowT>0 && G.state!=='over'){
    const g=ctx.createRadialGradient(W/2,H/2,60,W/2,H/2,240);
    g.addColorStop(0,'rgba(0,0,0,0)'); g.addColorStop(1,'rgba(0,0,0,0.55)');
    ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    ctx.fillStyle='rgba(255,226,122,'+(0.35+Math.sin(performance.now()/90)*0.2)+')';
    ctx.fillRect(0,0,W,2); ctx.fillRect(0,H-2,W,2);
  }
  ctx.restore();

  if(G.flash>0.01){
    ctx.fillStyle='rgba(255,255,255,'+G.flash*0.7+')';
    ctx.fillRect(0,0,W,H);
  }
  if(G.hitFlash>0.01){
    ctx.strokeStyle='rgba(255,246,200,'+G.hitFlash*0.55+')';
    ctx.lineWidth=6; ctx.strokeRect(3,3,W-6,H-6);
  }

  if(G.state!=='title' && G.state!=='slow' && G.state!=='over') drawHUD();
  drawBanner();
  if(G.state!=='over') drawMusicBtn();
  if(G.state==='title') drawTitle();
  if(G.state==='over') drawPaper();
}

let last=performance.now();
let errMsg='', errT=0;
function fail(e){
  errMsg=String((e&&e.message)||e);
  errT=2.5;
  try{ console.error(e); }catch(_){}
}
function loop(now){
  requestAnimationFrame(loop);
  let dt=(now-last)/1000; last=now;
  dt=Math.min(dt,0.05);
  try{ update(dt); }catch(e){ fail(e); }
  try{ render(); }catch(e){ fail(e); }
  if(errT>0){
    errT-=dt;
    try{
      ctx.save();
      ctx.font='bold 8px Courier New'; ctx.textAlign='left'; ctx.textBaseline='alphabetic';
      ctx.fillStyle='rgba(0,0,0,0.72)'; ctx.fillRect(0,H-16,W,16);
      ctx.fillStyle='#ff8a6a'; ctx.fillText(errMsg.slice(0,58),4,H-5);
      ctx.restore();
    }catch(_){}
  }
}

reset();
requestAnimationFrame(loop);
})();
