    type:'car', x:150, y:y, w:40*SC, h:74*SC, r:26*SC,
    vx:0, vy:0, color:pick(['#3a4a6a','#6a3a3a','#4a5a4a','#6a6a6a','#5a4a6a','#7a6a4a']),
    react:0, rot:0, rotV:0, kvx:0, kvy:0, dead:0, splat:false, sx:0, sy:0
  });
}

function toGame(e){
  const r=cvs.getBoundingClientRect();
  return { x:(e.clientX-r.left)*(W/r.width), y:(e.clientY-r.top)*(H/r.height) };
}
function down(e){
  e.preventDefault(); initAudio();
  const p=toGame(e);
  if(inBtn(p)){ toggleMusic(); G.btnPress=true; return; }
  if(G.state==='over'){
    if(G.overT>=OVER_GATE) reset();
    return;
  }
  if(G.state==='title'){
    G.state='slow'; G.decelT=0; G.banner='';
    beep(300,0.12,'sine',0.06);
    return;
  }
  if(G.state!=='aim') return;
  try{ cvs.setPointerCapture(e.pointerId); }catch(err){}
  G.aim.active=true; G.aim.px=p.x; G.aim.py=p.y; updateAim();
}
function move(e){
  if(!G.aim.active) return;
  e.preventDefault();
  const p=toGame(e);
  G.aim.px=p.x; G.aim.py=p.y; updateAim();
}
function up(e){
  if(G.btnPress){ G.btnPress=false; return; }
  if(!G.aim.active) return;
  e.preventDefault();
  G.aim.active=false;
  try{ cvs.releasePointerCapture(e.pointerId); }catch(err){}
  if(G.aim.power>0.26) throwEgg();
}
function cancel(e){
  if(!G.aim.active) return;
  G.aim.active=false;
  try{ cvs.releasePointerCapture(e.pointerId); }catch(err){}
}
function updateAim(){
  let dx=G.aim.px-winX(), dy=G.aim.py-winY();
  if(dx<4) dx=4;
  const d=Math.hypot(dx,dy)||1;
  dx/=d; dy/=d;
  const ang=clamp(Math.atan2(dy,dx), -1.35, 1.15);
  G.aim.dx=Math.cos(ang); G.aim.dy=Math.sin(ang);
  G.aim.power=clamp((d-25)/120, 0, 1);
}
cvs.addEventListener('pointerdown',down);
cvs.addEventListener('pointermove',move);
cvs.addEventListener('pointerup',up);
cvs.addEventListener('pointercancel',cancel);

function throwEgg(){
  if(G.eggs<=0) return;
  G.eggs--; G.throws++;
  const spd=200+G.aim.power*470;
  G.flying.push({x:winX(),y:winY(),vx:G.aim.dx*spd,vy:G.aim.dy*spd,rot:rnd(0,6.28),rv:rnd(-9,9),g:0.075});
  beep(520,0.07,'square',0.05);
  noise(0.06,0.05);
  if(G.eggs<=0){ G.banner='LAST EGG'; G.bannerT=0.9; }
}

function update(dt){
  updateBubbles(dt);

  if(G.state==='over'){
    G.overT+=dt;
    G.scroll+=dt*30;
    G.shake*=Math.pow(0.02,dt);
    G.flash*=Math.pow(0.01,dt);
    G.hitFlash*=Math.pow(0.005,dt);
    if(G.bannerT>0) G.bannerT-=dt;
    G.zoomTo=1;
    G.zoom+=(G.zoomTo-G.zoom)*Math.min(1,dt*5);
    updateTargets(dt*30,dt);
    return;
  }

  let ts=1;
  if(G.slowT>0){ G.slowT-=dt; ts=0.22; }
  G.timeScale=ts;
  const wdt=dt*ts;

  G.weavePhase+=dt*(1.25+Math.sin(performance.now()/3100)*0.35);
  G.weaveT-=dt;
  if(G.weaveT<=0){ G.weaveT=rnd(1.4,3.0); G.weaveAmpT=Math.random()<0.6?rnd(24,32):rnd(4,12); }
  G.weaveAmp+=(G.weaveAmpT-G.weaveAmp)*Math.min(1,dt*0.9);
  G.carX=CAR_X0-8+Math.sin(G.weavePhase)*G.weaveAmp;

  let speedMul=1;
  if(G.boostT>0){
    G.boostT-=dt;
    const p=1-G.boostT/0.85;
    const e=Math.sin(clamp(p,0,1)*Math.PI);
    G.carOffY=-62*e;
    speedMul=1+1.9*e;
    if(Math.random()<0.55) G.boostLines.push({x:rnd(0,ROAD_R),y:rnd(0,H),len:rnd(20,55),life:0.4});
  } else { G.carOffY=0; }
  for(let i=G.boostLines.length-1;i>=0;i--){
    const l=G.boostLines[i]; l.y+=760*dt; l.life-=dt;
    if(l.life<=0||l.y>H+60) G.boostLines.splice(i,1);
  }

  if(G.state==='title'){
    G.scrollSpeed=FLYBY;
    if(Math.random()<0.9) G.boostLines.push({x:rnd(0,ROAD_R),y:rnd(0,H),len:rnd(24,70),life:0.34});
  }
  if(G.state==='slow'){
    G.decelT+=dt;
    const p=clamp(G.decelT/1.15,0,1);
    G.scrollSpeed=FLYBY+(CRUISE-FLYBY)*(p*p);
    if(Math.random()<0.5) G.boostLines.push({x:rnd(0,ROAD_R),y:rnd(0,H),len:rnd(16,45),life:0.3});
    if(p>=1){
      G.state='aim'; G.scrollSpeed=CRUISE;
      driverSay(G.openDeck, DRIVER_OPEN);
      startMusic();
    }
  }

  const travel=G.scrollSpeed*speedMul*wdt;
  G.scroll+=travel;

  G.shake*=Math.pow(0.02,dt);
  G.flash*=Math.pow(0.01,dt);
  G.hitFlash*=Math.pow(0.005,dt);
  if(G.bannerT>0) G.bannerT-=dt;

  G.zoom+=(G.zoomTo-G.zoom)*Math.min(1,dt*5);

  if(G.state!=='outro'){
    if(G.slowT<=0 && G.state!=='title' && G.state!=='slow') G.zoomTo=1;
    G.boothAcc+=travel;
    if(G.boothAcc>145){ G.boothAcc-=145; spawnBooth(-105); }
    G.bikeT-=wdt;
    if(G.bikeT<=0){ G.bikeT=rnd(1.9,3.4); spawnBike(rnd(190,286),-45); }
    G.carT-=wdt;
    if(G.carT<=0){ G.carT=rnd(7.5,12.5); spawnCar(-90); }
  }

  updateBooths(travel);
  updateTargets(travel,dt);
  updateFlying(wdt);
  updateSplats(travel,dt);
  updateFx(dt);

  if(G.state==='outro'){
    if(G.phase==='idle'){
      G.zoomTo=1.08; G.zoomX=G.carX+10; G.zoomY=CAR_Y-10;
      G.holdT-=dt;
      if(G.holdT<=0){
        G.phase='burnout'; G.burnT=0.95; G.revT=0;
        G.banner='GET US OUTTA HERE'; G.bannerT=1.5;
        noise(0.3,0.18,700);
      }
    }
    if(G.phase==='burnout'){
      G.zoomTo=1.14; G.zoomX=G.carX+8; G.zoomY=CAR_Y-10;
      G.burnT-=dt;
      G.shake=Math.max(G.shake,4.5);
      G.carExitY+=14*dt;
      if(Math.random()<0.95) spawnSmoke(G.carX+rnd(-21,-7), CAR_Y+G.carExitY+26, rnd(-24,10), rnd(20,70));
      if(Math.random()<0.95) spawnSmoke(G.carX+rnd(7,21), CAR_Y+G.carExitY+26, rnd(-10,24), rnd(20,70));
      G.revT-=dt;
      if(G.revT<=0){ G.revT=rnd(0.07,0.13); beep(rnd(90,200),0.1,'sawtooth',0.05); }
      if(G.burnT<=0){
        G.phase='escape'; G.escT=0;
        G.banner=''; noise(0.55,0.24,900); beep(250,0.45,'sawtooth',0.11);
      }
    }
    if(G.phase==='escape'){
      G.escT+=dt;
      G.escV=Math.min(1000, 180+G.escT*1500);
      G.scrollSpeed=G.escV;
      G.carExitY=Math.min(16, G.carExitY+G.escV*0.02*dt);
      G.zoomTo=1.14-clamp(G.escT/2.2,0,1)*0.06;
      G.zoomX=G.carX; G.zoomY=CAR_Y-6;
      G.shake=Math.max(G.shake,3.6);
      G.carAlpha=1-clamp((G.escT-1.45)/0.8,0,1);
      G.haze=clamp((G.escT-1.25)/1.15,0,1);
      for(let i=0;i<3;i++){
        G.boostLines.push({x:rnd(0,ROAD_R),y:rnd(-30,H),len:rnd(40,140),life:rnd(0.28,0.5)});
      }
      if(Math.random()<0.9) spawnSmoke(G.carX+rnd(-20,20), CAR_Y+G.carExitY+30, rnd(-34,34), rnd(10,55));
      if(G.escT>2.45){
        G.state='over'; G.overT=0; G.zoomTo=1; G.zoom=1; G.phase='idle';
        G.carAlpha=1; G.haze=0; pickPaper(); stopMusic();
      }
    }
  }
}

function updateBubbles(dt){
  for(let i=G.bubbles.length-1;i>=0;i--){
    const b=G.bubbles[i];
    b.life-=dt; b.y-=10*dt;
    if(b.life<=0) G.bubbles.splice(i,1);
  }
}
function spawnSmoke(x,y,vx,vy){
  G.fx.push({type:'smoke',x:x,y:y,vx:vx,vy:vy,life:rnd(0.55,0.95),max:0.95,r:rnd(4,9)});
}
function pickPaper(){
  const h=G.hits;
  G.head = h>=11?pick(HEAD_BIG) : h>=8?pick(HEAD_BIG.concat(HEAD_MID)) : h>=5?pick(HEAD_MID) : pick(HEAD_LOW);
  G.sub = pick(SUBS);
  const q = (G.cas.car>0 && Math.random()<0.5) ? pick(QUOTES_CAR) : pick(QUOTES);
  G.quote=q[0]; G.quoteBy=q[1];
}
function updateBooths(d){
  for(let i=G.booths.length-1;i>=0;i--){
    const b=G.booths[i];
    b.y+=d;
    if(b.y>H+170){
      for(const p of b.peds){
        const k=G.targets.indexOf(p);
        if(k>=0) G.targets.splice(k,1);
      }
      G.booths.splice(i,1);
    }
  }
}
function updateTargets(travel,dt){
  const step=dt*G.timeScale;
  for(let i=G.targets.length-1;i>=0;i--){
    const t=G.targets[i];
    if(t.dead>0){
      t.dead-=step;
      t.x+=t.kvx*step; t.y+=t.kvy*step+travel;
      t.kvx*=Math.pow(0.15,step); t.kvy*=Math.pow(0.15,step);
      t.rot+=t.rotV*step; t.rotV*=Math.pow(0.3,step);
      if(t.dead<=0) G.targets.splice(i,1);
      continue;
    }
    if(t.react>0){
      t.react-=step;
      t.x+=t.kvx*step; t.y+=t.kvy*step+travel;
      t.kvx*=Math.pow(0.08,step); t.kvy*=Math.pow(0.08,step);
      t.rot+=t.rotV*step; t.rotV*=Math.pow(0.4,step);
      if(t.react<=0) t.dead=1.1;
      continue;
    }
    if(t.type==='ped'){
      t.wob+=step*t.wobS;
      t.phase+=step*0.9;
      t.x=t.home.x+t.ax+Math.sin(t.wob)*t.wobR;
      t.y=t.home.y+t.ay+Math.cos(t.wob*0.73)*t.wobR*0.6;
    } else if(t.type==='bike'){
      t.phase+=step*9;
      t.wob+=step*1.7;
      t.x+=t.vx*step;
      t.y+=travel;
      if(t.x<WALK_L+8){ t.x=WALK_L+8; t.vx=Math.abs(t.vx); }
      if(t.x>294){ t.x=294; t.vx=-Math.abs(t.vx); }
      if(Math.random()<0.026) t.vx=clamp(t.vx+rnd(-26,26),-44,44);
    } else {
      t.y+=travel;
    }
    if(t.y>H+140 && t.type!=='ped') G.targets.splice(i,1);
  }
}
function updateFlying(dt){
  for(let i=G.flying.length-1;i>=0;i--){
    const e=G.flying[i];
    if(e.g>0){ e.g-=dt; }
    const dr=Math.exp(-1.6*dt);
    e.vx*=dr; e.vy*=dr;
    e.x+=e.vx*dt; e.y+=e.vy*dt;
    e.rot+=e.rv*dt;
    if(e.chain) e.life-=dt;
    let hit=null;
    if(e.g<=0){
      for(const t of G.targets){
        if(t.dead>0) continue;
        if(e.src===t) continue;
        if(Math.abs(e.x-t.x)<t.w/2+6 && Math.abs(e.y-t.y)<t.h/2+6){ hit=t; break; }
      }
    }
    if(hit){ G.flying.splice(i,1); resolveHit(e,hit); continue; }
    const spd=Math.hypot(e.vx,e.vy);
    if(spd<28 || e.x>W+14 || e.y<-24 || e.y>H+24 || (e.chain && e.life<=0)){
      G.flying.splice(i,1);
      addSplat(clamp(e.x,0,W),clamp(e.y,0,H),e.chain?rnd(0.2,0.4):rnd(0.35,0.6));
      if(e.chain) checkEnd(); else missResolve();
    }
  }
}
function resolveHit(e, t){
  const spd=Math.hypot(e.vx,e.vy)||1;
  const nx=e.vx/spd, ny=e.vy/spd;
  t.splat=true; t.sx=rnd(-6,6); t.sy=rnd(-8,8);
  addSplat(t.x+rnd(-4,4), t.y+rnd(-4,4), rnd(0.85,1.25));

  if(t.type==='car'){
    G.cas.car++;
    addFx(t.x, t.y-18, 'CLANG', '#cfd8e0', 13);
    noise(0.12,0.13,900); beep(430,0.09,'square',0.05);
    G.streak=0;
    checkEnd();
    return;
  }

  if(t.type==='bike') G.cas.bike++; else G.cas.ped++;
  t.react=1.0; t.kvx=nx*90; t.kvy=ny*70; t.rotV=nx*11+(Math.random()<0.5?-6:6);
  G.hits++; G.streak++; G.bestStreak=Math.max(G.bestStreak,G.streak);
  G.tier=Math.min(3,Math.floor(G.hits/3));
  if(G.hits%3===0 && mus) mus.bpm=Math.min(174,mus.bpm+6);
  if(Math.random()<0.6) addSplat(t.x+rnd(-16,16), t.y+rnd(-16,16), rnd(0.3,0.65));
  if(Math.random()<0.3) addSplat(t.x+rnd(-24,24), t.y+rnd(-24,24), rnd(0.22,0.45));
  addFx(t.x,t.y-12,'SPLAT!','#fff6c8',15);
  G.hitFlash=1;
  noise(0.14,0.14); beep(300,0.09,'triangle',0.06);
  sayShout(t);

  if(!e.chain && Math.random()<CHAIN_CHANCE){
    let best=null, bd=1e9;
    for(const o of G.targets){
      if(o===t || o.dead>0 || o.type==='car') continue;
      const d=Math.hypot(o.x-t.x, o.y-t.y);
      if(d<bd){ bd=d; best=o; }
    }
    if(best && bd<150){
      const a=Math.atan2(best.y-t.y, best.x-t.x);
      G.flying.push({
        x:t.x, y:t.y, vx:Math.cos(a)*250, vy:Math.sin(a)*250,
        rot:rnd(0,6.28), rv:rnd(-15,15), g:0, chain:true, src:t, life:0.8
      });
      addFx(t.x, t.y-24, 'CHAIN', '#ffd24a', 12);
      beep(880,0.1,'square',0.06);
      beep(1180,0.08,'square',0.04);
      G.shake=Math.max(G.shake,4);
      G.flash=Math.max(G.flash,0.35);
    }
  }
  if(G.streak>=3){
    G.streak=0; G.boostT=0.85; G.shake=9;
    G.flash=Math.max(G.flash,0.5);
    addFx(G.carX, CAR_Y-50, 'FLOOR IT', '#8fe0ff', 12);
    beep(720,0.16,'sawtooth',0.08);
    driverSay(G.streakDeck, DRIVER_STREAK);
  }
  if(G.hits>=8 && !G.eightHit && G.state==='aim'){
    G.eightHit=true;
    G.banner='8 HITS — CLEAN'; G.bannerT=1.5; beep(700,0.2,'sine',0.09);
  }
  if(Math.random()<0.125){
    G.slowT=1.7; G.zoomTo=1.45; G.zoomX=t.x; G.zoomY=t.y;
    addFx(t.x,t.y-26,'SLOW-MO','#ffe27a',11);
  }
  checkEnd();
}
function missResolve(){
  G.streak=0;
  beep(200,0.06,'sine',0.04);
  if(Math.random()<0.6) driverSay(G.missDeck, DRIVER_MISS);
  checkEnd();
}
function checkEnd(){
  if(G.state!=='aim') return;
  if(G.eggs>0) return;
  if(G.flying.length>0) return;
  G.state='outro'; G.phase='idle'; G.holdT=0.85;
  G.burnT=0; G.escV=0; G.carExitY=0; G.revT=0; G.escT=0; G.carAlpha=1; G.haze=0;
  G.scrollSpeed=34; G.slowT=0;
  beep(620,0.16,'sine',0.07);
}

function addSplat(x,y,s){
  if(!isFinite(x)||!isFinite(y)) return;
  if(!isFinite(s)||s<=0) s=0.5;
  const n=3+Math.floor(Math.random()*9);
  const blobs=[];
  for(let i=0;i<n;i++){
    const a=rnd(0,6.28), d=rnd(0,13);
    const base=rnd(2.2,7.5);
    const stretch=rnd(1,1.95);
    blobs.push({a:a,d:d,rx:base*stretch,ry:base/stretch,rot:a+rnd(-0.45,0.45)});
  }
  const drips=[];
  const dn=Math.random()<0.7?Math.floor(rnd(1,4)):0;
  for(let i=0;i<dn;i++) drips.push({dx:rnd(-11,11),dy:rnd(1,7),len:rnd(4,17),w:rnd(1.4,3.4)});
  const yolk=Math.random()<0.75?{dx:rnd(-3.5,3.5),dy:rnd(-3.5,3.5),r:rnd(2.2,4.8)}:null;
  G.splats.push({x:x,y:y,s:s,life:6,max:6,blobs:blobs,drips:drips,yolk:yolk});
}
function updateSplats(travel,dt){
  const step=dt*G.timeScale;
  for(let i=G.splats.length-1;i>=0;i--){
    const s=G.splats[i];
    s.y+=travel; s.life-=step;
    if(s.life<=0||s.y>H+80) G.splats.splice(i,1);
  }
}
function addFx(x,y,text,color,size){
  G.fx.push({type:'text',x:x,y:y,vx:0,vy:-26,life:1.1,max:1.1,text:text,color:color,size:size});
}
function updateFx(dt){
  for(let i=G.fx.length-1;i>=0;i--){
    const f=G.fx[i];
    f.life-=dt;
    if(f.type==='chunk'){ f.x+=f.vx*dt; f.y+=f.vy*dt; f.vx*=Math.pow(0.2,dt); f.vy*=Math.pow(0.2,dt); }
    else if(f.type==='smoke'){ f.x+=f.vx*dt; f.y+=f.vy*dt; f.vx*=Math.pow(0.4,dt); f.vy*=Math.pow(0.4,dt); f.r+=24*dt; }
    else if(f.type==='text'){ f.y+=f.vy*dt; f.vy*=Math.pow(0.3,dt); }
    else if(f.type==='ring'){ f.r+=520*dt; }
    if(f.life<=0) G.fx.splice(i,1);
  }
}

function drawRoad(){
  const sp=G.scroll;
  const TOP=-H, BOT=H*2;
  ctx.fillStyle='#2c2c32'; ctx.fillRect(0,TOP,ROAD_R,BOT-TOP);
  ctx.fillStyle='rgba(255,255,255,0.035)';
  for(let i=0;i<70;i++){
    const x=((i*137)%ROAD_R);
    for(let k=0;k<3;k++){
      const y=((i*311+sp)%H)+k*H;
      ctx.fillRect(x,y,2,2);
    }
  }
  ctx.fillStyle='rgba(240,220,120,0.55)';
  for(let y=(sp%60)-60-H; y<BOT+60; y+=60) ctx.fillRect(14,y,4,32);
  ctx.fillStyle='rgba(240,240,240,0.5)';
  ctx.fillRect(ROAD_R-8,TOP,4,BOT-TOP);
  ctx.fillStyle='rgba(240,240,240,0.14)';
  for(let y=(sp%40)-40-H; y<BOT+40; y+=40) ctx.fillRect(ROAD_R-26,y,2,18);
  ctx.fillStyle='#8b8b84'; ctx.fillRect(CURB_L,TOP,8,BOT-TOP);
  ctx.fillStyle='rgba(200,60,60,0.55)';
  for(let y=(sp%46)-46-H; y<BOT+46; y+=46) ctx.fillRect(CURB_L,y,8,24);
  ctx.fillStyle='#9d9d95'; ctx.fillRect(WALK_L,TOP,W-WALK_L,BOT-TOP);
  ctx.strokeStyle='rgba(0,0,0,0.13)'; ctx.lineWidth=1;
  for(let y=(sp%52)-52-H; y<BOT+52; y+=52){
    ctx.beginPath(); ctx.moveTo(WALK_L,y); ctx.lineTo(W,y); ctx.stroke();
  }
  for(let x=WALK_L+30;x<W;x+=44){
    ctx.beginPath(); ctx.moveTo(x,TOP); ctx.lineTo(x,BOT); ctx.stroke();
  }
  const gr=ctx.createLinearGradient(WALK_L,0,WALK_L+16,0);
  gr.addColorStop(0,'rgba(0,0,0,0.28)'); gr.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=gr; ctx.fillRect(WALK_L,TOP,16,BOT-TOP);
}

function drawBooths(){ for(const b of G.booths) drawBooth(b); }

function drawBooth(b){
  const w=BOOTH_W, h=BOOTH_H;
  ctx.save();
  ctx.translate(b.x, b.y);
  ctx.scale(SC,SC);
  ctx.fillStyle='#3e3328'; ctx.fillRect(w-5,0,5,h);
  const cols = b.kind===0?['#c33b46','#f2e8d4']: b.kind===1?['#2f6fb0','#f2e8d4']:['#3d8a4a','#f2e8d4'];
  for(let i=0;i<6;i++){
    ctx.fillStyle=cols[i%2];
    ctx.fillRect(0, i*(h/6), w-5, h/6);
  }
  ctx.fillStyle='rgba(0,0,0,0.22)'; ctx.fillRect(0,0,7,h);
  ctx.strokeStyle='rgba(0,0,0,0.4)'; ctx.lineWidth=1;
  ctx.strokeRect(0.5,0.5,w-6,h-1);
  ctx.fillStyle='#5a4a38';
  ctx.fillRect(1,1,3,10); ctx.fillRect(1,h-11,3,10);
  ctx.fillStyle='#7a5c3c'; ctx.fillRect(19,5,14,h-10);
  ctx.fillStyle='rgba(0,0,0,0.22)'; ctx.fillRect(19,5,3,h-10);
