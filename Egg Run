    vx:rnd(-34,34), vy:0, shirt:pick(SHIRTS), skin:pick(SKINS),
    phase:rnd(0,6.28), wob:rnd(0,6.28), react:0, rot:0, rotV:0, kvx:0, kvy:0, dead:0, splat:false, sx:0, sy:0
