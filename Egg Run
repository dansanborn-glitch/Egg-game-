function drawSplat(s){
  const a=clamp(s.life/s.max,0,1);
  const k=s.s*SC*SPLAT_SCALE;
  ctx.save(); ctx.globalAlpha=a*0.95;
  ctx.fillStyle='#fdf8e6';
  for(const b of s.blobs){
    const bx=s.x+Math.cos(b.a)*b.d*k, by=s.y+Math.sin(b.a)*b.d*k;
    ctx.save(); ctx.translate(bx,by); ctx.rotate(b.rot);
    ctx.beginPath(); ctx.ellipse(0,0,b.rx*k,b.ry*k,0,0,6.29); ctx.fill();
    ctx.restore();
  }
  for(const d of s.drips){
    const dx=s.x+d.dx*k, dy=s.y+d.dy*k;
    ctx.beginPath();
    ctx.ellipse(dx, dy+d.len*k*0.5, d.w*k*0.5, d.len*k*0.5, 0, 0, 6.29);
    ctx.fill();
    ctx.beginPath(); ctx.arc(dx, dy+d.len*k, d.w*k*0.55, 0, 6.29); ctx.fill();
  }
  ctx.beginPath(); ctx.arc(s.x,s.y,10*k,0,6.29); ctx.fill();
  if(s.yolk){
    ctx.fillStyle='#f0c22a';
    ctx.beginPath(); ctx.arc(s.x+s.yolk.dx*k, s.y+s.yolk.dy*k, s.yolk.r*k, 0, 6.29); ctx.fill();
  }
  ctx.restore();
}

