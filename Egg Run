function drawAim(){
  if(!G.aim.active || G.aim.power<0.05) return;
  const wx=winX(), wy=winY();
  let x=wx, y=wy, vx=G.aim.dx*(200+G.aim.power*470), vy=G.aim.dy*(200+G.aim.power*470);
  ctx.fillStyle='rgba(255,255,255,0.55)';
  for(let i=0;i<46;i++){
    const t=1/60;
    vx*=Math.exp(-1.6*t); vy*=Math.exp(-1.6*t);
    x+=vx*t; y+=vy*t;
    if(i%2===0 && x<W && y>0 && y<H){
      ctx.globalAlpha=clamp(1-i/46,0,1)*0.85;
      ctx.beginPath(); ctx.arc(x,y,1.9,0,6.29); ctx.fill();
