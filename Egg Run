  ctx.fillRect(wx-3, wy+19+(34-hh), 6, hh);
  ctx.strokeStyle='rgba(255,255,255,0.28)'; ctx.setLineDash([3,3]);
  ctx.beginPath(); ctx.moveTo(wx,wy); ctx.lineTo(G.aim.px,G.aim.py); ctx.stroke();
  ctx.setLineDash([]);
}

