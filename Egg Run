function winX(){ return G.carX+25; }
function winY(){ return CAR_Y+G.carOffY; }

function shuffle(a){
  for(let i=a.length-1;i>0;i--){ const j=(Math.random()*(i+1))|0; const t=a[i]; a[i]=a[j]; a[j]=t; }
}
function nextFrom(deck, src){
  if(deck.length===0){ for(const s of src) deck.push(s); shuffle(deck); }
  return deck.pop();
}

function pushBubble(x,y,text){
  let yy=y;
  for(const b of G.bubbles){
    if(Math.abs(b.x-x)<112 && Math.abs(b.y-yy)<70) yy=b.y-74;
  }
  yy=clamp(yy,118,H-30);
  G.bubbles.push({x:clamp(x,52,W-52), y:yy, text:text, life:1.9, max:1.9});
  if(G.bubbles.length>3) G.bubbles.shift();
}
function sayShout(t){ pushBubble(t.x+rnd(-6,6), t.y-18, nextFrom(G.shoutDeck, SHOUTS)); }
function driverSay(deck, src){ pushBubble(winX()+6, winY()-34, nextFrom(deck, src)); }

function inBtn(p){ return p.x>=BTN.x-5 && p.x<=BTN.x+BTN.w+5 && p.y>=BTN.y-5 && p.y<=BTN.y+BTN.h+5; }
function toggleMusic(){
  G.musicOn=!G.musicOn;
  if(!G.musicOn) stopMusic();
  else if(G.state==='aim'||G.state==='outro') startMusic();
  beep(G.musicOn?660:330,0.08,'square',0.05);
}

function reset(){
  stopMusic();
  G.eggs=12; G.hits=0; G.throws=0; G.streak=0; G.bestStreak=0; G.tier=0;
