}

const SHIRTS=['#c94b4b','#4b7bc9','#4bc98a','#c9a24b','#9a4bc9','#e07a3c','#3cb8c9','#d9d9d9','#7a4b2a','#c94b9a','#5b6b8a','#b04b6a'];
