(function(){
const W=300,H=450;
const cvs=document.getElementById('c');
const ctx=cvs.getContext('2d');
const dpr=Math.min(window.devicePixelRatio||1,2);
cvs.width=W*dpr; cvs.height=H*dpr;
ctx.scale(dpr,dpr);
const wrap=document.getElementById('wrap');
function fit(){
  const s=Math.min(window.innerWidth/(W+16), window.innerHeight/(H+16), 1);
  wrap.style.transform='scale('+s+')';
}
window.addEventListener('resize',fit); fit();

const rnd=(a,b)=>a+Math.random()*(b-a);
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const pick=a=>a[(Math.random()*a.length)|0];

const SC=1.15;
const SPLAT_SCALE=0.375;
const CRUISE=98, FLYBY=430;
const CHAIN_CHANCE=1/7;
const OVER_GATE=1.0;
const BTN={x:8, y:H-40, w:38, h:24};

let AC=null, musicGain=null, noiseBuf=null, mus=null, gtrBus=null, comp=null;

function initAudio(){
  if(!AC){
    try{
      AC=new (window.AudioContext||window.webkitAudioContext)();
      comp=AC.createDynamicsCompressor();
      comp.threshold.value=-19; comp.knee.value=10; comp.ratio.value=6;
      comp.attack.value=0.003; comp.release.value=0.15;
      musicGain=AC.createGain(); musicGain.gain.value=0.42;
      musicGain.connect(comp); comp.connect(AC.destination);

      const n=2048, c=new Float32Array(n);
      for(let i=0;i<n;i++){ const x=i*2/n-1; c[i]=Math.tanh(x*5.5); }
      const shaper=AC.createWaveShaper(); shaper.curve=c; shaper.oversample='4x';
      const hp=AC.createBiquadFilter(); hp.type='highpass'; hp.frequency.value=64;
      const lp=AC.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=3100; lp.Q.value=0.8;
      gtrBus=AC.createGain(); gtrBus.gain.value=0.85;
      shaper.connect(hp); hp.connect(lp); lp.connect(gtrBus); gtrBus.connect(musicGain);

      const b=AC.createBuffer(1,Math.floor(AC.sampleRate*0.4),AC.sampleRate);
      const d=b.getChannelData(0);
      for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1;
      noiseBuf=b;
    }catch(e){}
  }
  if(AC && AC.state==='suspended') AC.resume();
}
function beep(freq,dur,type,vol){
  if(!AC) return;
  const o=AC.createOscillator(), g=AC.createGain();
  o.type=type||'sine'; o.frequency.value=freq;
  g.gain.setValueAtTime(vol||0.06,AC.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001,AC.currentTime+dur);
  o.connect(g); g.connect(AC.destination);
  o.start(); o.stop(AC.currentTime+dur);
}
function noise(dur,vol,freq){
  if(!AC) return;
  const b=AC.createBuffer(1,Math.floor(AC.sampleRate*dur),AC.sampleRate);
  const d=b.getChannelData(0);
  for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*(1-i/d.length);
  const s=AC.createBufferSource(); s.buffer=b;
  const g=AC.createGain(); g.gain.value=vol||0.12;
  const f=AC.createBiquadFilter(); f.type='bandpass'; f.frequency.value=freq||1400;
  s.connect(f); f.connect(g); g.connect(AC.destination); s.start();
}

/* ---------- chip metal engine ---------- */
function mulberry32(a){
  return function(){
    a|=0; a=a+0x6D2B79F5|0;
    let t=Math.imul(a^a>>>15,1|a);
    t=t+Math.imul(t^t>>>7,61|t)^t;
    return ((t^t>>>14)>>>0)/4294967296;
  };
}
const mtof=m=>440*Math.pow(2,(m-69)/12);
function rpick(r,a){ return a[(r()*a.length)|0]; }

const POWER=[0,7,12], DETUNE=[-7,5,-4];

function chord(t, midi, dur, vol, mute){
  if(!AC||!gtrBus) return;
  for(let i=0;i<3;i++){
    const o=AC.createOscillator(), g=AC.createGain();
    o.type = i===2?'sawtooth':'square';
    o.frequency.setValueAtTime(mtof(midi+POWER[i])*Math.pow(2,DETUNE[i]/1200), t);
    g.gain.setValueAtTime(0.0001,t);
    if(mute){
      g.gain.exponentialRampToValueAtTime(vol,t+0.005);
      g.gain.exponentialRampToValueAtTime(0.0001,t+dur*0.6);
    } else {
      g.gain.exponentialRampToValueAtTime(vol,t+0.007);
      g.gain.exponentialRampToValueAtTime(vol*0.62,t+dur*0.62);
      g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    }
    o.connect(g); g.connect(gtrBus);
    o.start(t); o.stop(t+dur+0.04);
  }
}
function mv(t,freq,dur,type,vol){
  if(!AC) return;
  const o=AC.createOscillator(), g=AC.createGain();
  o.type=type; o.frequency.setValueAtTime(freq,t);
  g.gain.setValueAtTime(0.0001,t);
  g.gain.exponentialRampToValueAtTime(vol,t+0.01);
  g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
  o.connect(g); g.connect(musicGain);
  o.start(t); o.stop(t+dur+0.03);
}
function drumKick(t,vol){
  if(!AC) return;
  const o=AC.createOscillator(), g=AC.createGain();
  o.type='sine'; o.frequency.setValueAtTime(168,t);
  o.frequency.exponentialRampToValueAtTime(36,t+0.085);
  g.gain.setValueAtTime(vol||0.4,t);
  g.gain.exponentialRampToValueAtTime(0.001,t+0.14);
  o.connect(g); g.connect(musicGain); o.start(t); o.stop(t+0.16);
}
function drumSnare(t){
  if(!AC||!noiseBuf) return;
  const s=AC.createBufferSource(); s.buffer=noiseBuf;
  const f=AC.createBiquadFilter(); f.type='bandpass'; f.frequency.value=2100; f.Q.value=0.7;
  const g=AC.createGain();
  g.gain.setValueAtTime(0.26,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.15);
  s.connect(f); f.connect(g); g.connect(musicGain); s.start(t); s.stop(t+0.17);
  const o=AC.createOscillator(), og=AC.createGain();
  o.type='triangle'; o.frequency.setValueAtTime(196,t);
  og.gain.setValueAtTime(0.13,t); og.gain.exponentialRampToValueAtTime(0.001,t+0.09);
  o.connect(og); og.connect(musicGain); o.start(t); o.stop(t+0.1);
}
function drumHat(t,soft){
  if(!AC||!noiseBuf) return;
  const s=AC.createBufferSource(); s.buffer=noiseBuf;
  const f=AC.createBiquadFilter(); f.type='highpass'; f.frequency.value=7600;
  const g=AC.createGain();
  g.gain.setValueAtTime(soft?0.055:0.1,t);
  g.gain.exponentialRampToValueAtTime(0.001,t+0.05);
  s.connect(f); f.connect(g); g.connect(musicGain); s.start(t); s.stop(t+0.07);
}
function drumCrash(t){
  if(!AC||!noiseBuf) return;
  const s=AC.createBufferSource(); s.buffer=noiseBuf;
  const f=AC.createBiquadFilter(); f.type='highpass'; f.frequency.value=4200;
  const g=AC.createGain();
  g.gain.setValueAtTime(0.2,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.7);
  s.connect(f); f.connect(g); g.connect(musicGain); s.start(t); s.stop(t+0.75);
}

const RIFF=[
  [0,1,2,4,5,6,8,9,10,12,13,14],
  [0,1,2,4,5,6,8,10,11,12,13,14],
  [0,2,3,4,6,8,10,11,12,14],
  [0,1,2,3,4,5,6,8,9,10,11,12,13,14,15]
];
const ACCENT=[[0,8],[0,8,14],[0,4,8,12],[0,8,15]];
const ROOTS=[40,40,43,38];

function startMusic(){
  stopMusic();
  if(!AC || !G.musicOn) return;
  const seed=(Math.random()*1e9)|0;
  const r=mulberry32(seed);
  const bpm=126+Math.floor(r()*24);
  const scale=rpick(r,[[0,2,3,5,7,8,10],[0,3,5,7,10],[0,2,3,5,7,9,10]]);
  const t0=AC.currentTime+0.1;
  mus={t:t0, start:t0, step:0, bpm:bpm, scale:scale, r:r, bar:-1, cell:[0,1,2], timer:null};
  mus.timer=setInterval(musicTick,25);
}
function stopMusic(){
  if(mus){ if(mus.timer) clearInterval(mus.timer); mus=null; }
}
function musicTick(){
  if(!mus||!AC) return;
  if(mus.t>AC.currentTime+0.2) return;
  let guard=0;
  while(mus.t < AC.currentTime+0.2 && guard++<64){
    stepMusic(mus.step, mus.t);
    mus.t += (60/mus.bpm)/4;
    mus.step++;
  }
}
function stepMusic(step, t){
  const s=step%16, bar=Math.floor(step/16);
  const intro=(t-mus.start)<2.0;
  const tier=G.tier|0;

  if(s===0||s===8||s===11) drumKick(t,0.4);
  if(tier>=2 && (s===3||s===7||s===13||s===15)) drumKick(t,0.24);
  if(s===4||s===12) drumSnare(t);
  if(s%2===0) drumHat(t, s%4!==0);
  if(s===0 && bar%4===0) drumCrash(t);

  if(intro) return;

  const bi=bar%4;
  if(mus.bar!==bar){
    mus.bar=bar;
    mus.cell=[0,1,2,3].map(()=>rpick(mus.r,mus.scale));
  }
  const root=ROOTS[bi];

  if(ACCENT[bi].indexOf(s)>=0) chord(t, root, 0.26, 0.085);
  else if(RIFF[bi].indexOf(s)>=0 && tier>=1) chord(t, root, 0.1, 0.058, true);
  else if(tier===0 && s%4===0) chord(t, root, 0.14, 0.06, true);

  if(s===0) mv(t, mtof(root+36), 0.18, 'square', 0.018);
  if(tier>=2 && (s===10||s===15)){
    const d=mus.cell[(s/8)|0];
    mv(t, mtof(root+24+d), 0.15, 'square', 0.03);
  }
  if(tier>=3 && s===6) mv(t, mtof(root+31), 0.12, 'sawtooth', 0.022);
}

