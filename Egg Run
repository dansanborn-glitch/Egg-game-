function spawnBooth(y){
  const b={x:BOOTH_X, y:y, kind:Math.floor(Math.random()*3), peds:[]};
  G.booths.push(b);
  const n=7+Math.floor(Math.random()*5);
  for(let i=0;i<n;i++){
    const ax = Math.random()<0.24 ? rnd(18,50) : rnd(-64,18);
    spawnPed(b, ax, rnd(-32,84));
  }
}
function spawnPed(home, ax, ay){
  const p={
    type:'ped', x:home.x+ax, y:home.y+ay, w:15*SC, h:15*SC, r:7*SC,
    home:home, ax:ax, ay:ay, wob:rnd(0,6.28), wobR:rnd(0.5,1.9), wobS:rnd(0.1,0.3),
    shirt:pick(SHIRTS), skin:pick(SKINS), face:rnd(0,6.28),
    hat:Math.random()<0.32, phase:rnd(0,6.28),
    react:0, rot:0, rotV:0, kvx:0, kvy:0, dead:0, splat:false, sx:0, sy:0
  };
  G.targets.push(p); home.peds.push(p);
  return p;
}
